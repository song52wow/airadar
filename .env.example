# ========== AI 模型配置 ==========

# 模型提供商: gemini | openai-compat
# gemini: 使用 Google Gemini API（需要 @google/genai SDK）
# openai-compat: 兼容 OpenAI API 格式（支持 DeepSeek / MiniMax / Codex / 硅基流动 等）
AI_PROVIDER="gemini"

# API 密钥
# 当 AI_PROVIDER=gemini 时，也会从 GEMINI_API_KEY 回退读取
AI_API_KEY="sk-your-api-key"

# 模型名称（不设置则使用默认值）
# gemini 默认: gemini-3.5-flash
# openai-compat 按 base_url 智能推断: deepseek→deepseek-chat, minimax→abab6.5s-chat
AI_MODEL=""

# API 基础地址（仅 openai-compat 需要）
# DeepSeek:  https://api.deepseek.com
# MiniMax:   https://api.minimax.chat/v1
# Codex:     https://api.codex.jd.com/v1
AI_BASE_URL=""

# ========== 兼容旧配置 ==========
# GEMINI_API_KEY: 当 AI_PROVIDER=gemini 且 AI_API_KEY 未设置时回退读取
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ========== 其他配置 ==========
# APP_URL: 应用托管地址
APP_URL="MY_APP_URL"

# RSSHUB_URL: RSSHub 实例地址
RSSHUB_URL="https://rsshub.rssforever.com"

# POLL_INTERVAL_MS: 新闻轮询间隔（毫秒，默认 900000 = 15 分钟）
POLL_INTERVAL_MS="900000"

# LOG_LEVEL: 服务端日志级别 (debug|info|warn|error)
# 留空时：dev 模式 = debug，prod 模式 = info
# debug/info 输出到 stdout，warn/error 输出到 stderr（Unix 惯例）
LOG_LEVEL=""
